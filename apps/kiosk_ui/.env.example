# Moosinsa Kiosk UI 환경변수 템플릿
# 각 키오스크 기기에서 이 파일을 .env 로 복사한 뒤 값을 수정한다.

# 메인 서비스 주소
MOOSINSA_SERVICE_HOST=192.168.1.120
MOOSINSA_SERVICE_PORT=8000

# 키오스크 식별자 (page_event 로깅 용)
MOOSINSA_KIOSK_ID=kiosk_1

# [좌석환경변수] 키오스크가 배치된 좌석 번호 (1~4 정수).
# 기기별로 반드시 다른 값으로 설정해야 한다. 누락/범위 밖이면 앱이 시작되지 않는다.
MOOSINSA_SEAT_ID=1
